    {
      "id": "shTjZiTirxLAG3c1XuQru",
      "type": "text",
      "x": 4600.895768842355,
      "y": 18590.5683349062,
      "width": 247.29588317871094,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
