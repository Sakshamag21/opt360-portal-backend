    {
      "id": "qpI7NaFzCaQFITOSwVpUG",
      "type": "text",
      "x": 3689.789768490795,
      "y": 21222.844182682074,
      "width": 769.53955078125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
