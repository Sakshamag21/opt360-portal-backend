    {
      "id": "lgwQI03BnC7gumZkIXWsh",
      "type": "text",
      "x": 3660.0566258363524,
      "y": 18995.877797560537,
      "width": 643.4957885742188,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6H",
      "roundness": null,
      "seed": 200717242,
      "version": 537,
      "versionNonce": 747427878,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785319178615,
      "link": null,
      "locked": false,
      "text": "-If there is a risk score, then its internal\ncategory score should justify it.\n- If the category scores is high there should \nbe the anomalous eids for that operator\n- If there are no anomalous eids for that\n features then internal features should define \nits reason  ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-If there is a risk score, then its internal\ncategory score should justify it.\n- If the category scores is high there should \nbe the anomalous eids for that operator\n- If there are no anomalous eids for that\n features then internal features should define \nits reason  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
