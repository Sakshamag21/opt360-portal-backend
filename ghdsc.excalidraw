      "seed": 991758220,
      "version": 760,
      "versionNonce": 677376012,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786967362658,
      "link": null,
      "locked": false,
      "text": "In this layer Report is verified, means uptil now the validation layers solely \ndepends on the count of features but in the logical validation of the features\nwill be done. Logical validation in the sense that on the serving side if the \nsomething is shown that it should be traceable with proofs, means for a \nscore there should be enough features to support and based on those if \nthe eids are available then those eids should be visible",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this layer Report is verified, means uptil now the validation layers solely \ndepends on the count of features but in the logical validation of the features\nwill be done. Logical validation in the sense that on the serving side if the \nsomething is shown that it should be traceable with proofs, means for a \nscore there should be enough features to support and based on those if \nthe eids are available then those eids should be visible",
      "autoResize": true,
      "lineHeight": 1.25
    },
