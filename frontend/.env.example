# WSO2 Identity Server OIDC Configuration
# Copy this file to .env and update with your actual values

# WSO2 Identity Server Base URL
REACT_APP_WSO2_AUTHORITY=https://sso.uidai.net.in/oauth2/token/.well-known/openid-configuration

# OAuth Client Configuration
# REACT_APP_CLIENT_ID=9HGuTetQjRjxkx1vHmoP1v0fXm8a
# REACT_APP_CLIENT_SECRET=RlsK9p2f4kJ_iKBZLSgiBYuIKjQa

# Redirect URIs (update with your domain)
# REACT_APP_REDIRECT_URI=http://localhost:3000/callback
# REACT_APP_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
# REACT_APP_SILENT_REDIRECT_URI=http://localhost:3000/silent-renew

# WSO2 IS 5.11 Endpoints (if autodiscovery doesn't work)
# REACT_APP_WSO2_ISSUER=https://your-wso2-server.com:9443/oauth2/token
# REACT_APP_AUTHORIZATION_ENDPOINT=https://your-wso2-server.com:9443/oauth2/authorize
# REACT_APP_TOKEN_ENDPOINT=https://your-wso2-server.com:9443/oauth2/token
# REACT_APP_USERINFO_ENDPOINT=https://your-wso2-server.com:9443/oauth2/userinfo
# REACT_APP_END_SESSION_ENDPOINT=https://your-wso2-server.com:9443/oidc/logout
# REACT_APP_JWKS_URI=https://your-wso2-server.com:9443/oauth2/jwks

# Example for production:
# REACT_APP_WSO2_AUTHORITY=https://wso2.company.com:9443/oauth2/oidcdiscovery
# REACT_APP_CLIENT_ID=operator_360_client
# REACT_APP_REDIRECT_URI=https://operator360.company.com/callback
# REACT_APP_POST_LOGOUT_REDIRECT_URI=https://operator360.company.com
