# Copy this file to .env in the same folder and fill in real values.
# .env is only read locally by feedback_to_kafka.py — it is never sent anywhere else.

# --- S3: where POST /api/feedback writes feedback.json + evidence files ---
# Same values the backend uses (OPT360_S3_* / OPT360_FEEDBACK_* in backend/.env).
S3_ENDPOINT=CHANGE_ME
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Falls back to S3_BUCKET_NAME if left blank, same as the backend's
# config.Feedback.BucketName fallback.
FEEDBACK_BUCKET_NAME=CHANGE_ME
S3_BUCKET_NAME=CHANGE_ME
# Must match backend's feedback.prefix / OPT360_FEEDBACK_PREFIX exactly, or
# nothing will be found. Leave blank if the backend has no prefix configured.
FEEDBACK_PREFIX=

# --- Kafka: topic feedback events get (re)published to ---
# Same values the backend uses (OPT360_KAFKA_* in backend/.env).
KAFKA_BROKERS=CHANGE_ME
KAFKA_TOPIC=CHANGE_ME
# One of plain | scram-sha-256 | scram-sha-512, or blank for no auth/TLS.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- MySQL: portal_users (strot_services.opt360_portal_users) ---
# Optional. feedback.json only stores the submitter's ad_id (via the S3 path),
# not their name/email/regional_office — set these to enrich the republished
# event with that info, looked up by ad_id. Leave MYSQL_HOST blank to skip
# enrichment entirely (event.user.name/email will just be blank).
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=strot_services
MYSQL_PORTAL_USERS_TABLE=opt360_portal_users
