# Copy this file to .env in the same folder and fill in real values.
# .env is only read locally by risk_audit.py — it is never sent anywhere else.

# --- MySQL: operator360.opt_master (overall risk_score per operator) ---
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=operator360

# --- ClickHouse: risk_analysis (category scores) + anomalous_packets_v2_rmt ---
# Same values the backend uses (OPT360_CLICKHOUSE_* in backend/.env) — HTTP
# interface, so PORT is normally 8123 (or 8443 if CLICKHOUSE_SECURE=true).
CLICKHOUSE_HOST=CHANGE_ME
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=CHANGE_ME
CLICKHOUSE_USERNAME=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
CLICKHOUSE_SECURE=false

# --- Audit tuning ---
# Max allowed |category_score - risk_score| for a category to "justify" the
# operator's overall risk_score.
DEVIATION_THRESHOLD=0.05

# For document/biometrics/suspicious only: minimum anomalous SID/EID count
# required, by that category's own score. Format: "lower_bound:min_count,..."
# (scores are 0.0-1.0). A category score falls into the highest bracket whose
# lower_bound it meets or exceeds, e.g. score 0.60 -> the 0.50 bracket -> needs
# >= 7 anomalous rows. Leave blank to use the default below.
# Default: 0.00-0.25 -> 1, 0.25-0.50 -> 3, 0.50-0.75 -> 7, 0.75-1.00 -> 15
BRACKETS=0.00:1,0.25:3,0.50:7,0.75:15

# opt_master.risk_bucket values (case-insensitive) that must have at least one
# anomalous row across document/biometrics/suspicious combined, regardless of
# risk_score/category-score matching. Comma-separated. Add "high" here too if
# you want that severity held to the same standard as "critical".
HIGH_SEVERITY_BUCKETS=critical

OUTPUT_CSV=risk_audit_report.csv
