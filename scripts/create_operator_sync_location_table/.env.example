# Copy this file to .env in the same folder and fill in real values.
# .env is only read locally by create_operator_sync_location_table.py — it is
# never sent anywhere else.

# --- MySQL: operator360 (creates the database itself if it doesn't exist) ---
MYSQL_HOST=CHANGE_ME
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=operator360
